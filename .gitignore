# R specific
.Rhistory
.RData
.Rproj.user/
*.Rproj
README.html

# R Environment Variables
.Renviron
.Rprofile

# renv (local development environment only, not part of the package)
renv/
renv.lock

# Build artifacts
/*.tar.gz
/*.Rcheck/
*.zip
Meta/
doc/
inst/doc
vignettes/*.html
vignettes/*.pdf
vignettes/*.R
vignettes/.build.timestamp

# Compiled code
src/*.o
src/*.so
src/*.dll
src/*.dylib

# Historical copies kept for reference, excluded from the build via .Rbuildignore
archive/

# macOS
.DS_Store

# Temporary files
*~
*.swp
*.swo

# Deliberately NOT ignored:
#   .Rbuildignore   package metadata; a clone must be able to reproduce the tarball
#   docs/           pkgdown output, published via GitHub Pages
#   scripts/        paper reproduction scripts (excluded from the build, not from the repo)

# iCloud sync writes conflict copies -- "tilting 2.R" beside "tilting.R" --
# into directories while R is building in them. One landed in R/ and would have
# shipped; ten landed in docs/ and would have been published. See
# tools/platform-checks/check-outside-icloud.sh.
* [0-9].*
* ([0-9]).*
