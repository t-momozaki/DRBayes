## Version used in the package (Manual) citation. `meta` is supplied by
## utils::citation(); fall back gracefully when the file is sourced directly.
pkg_version <- if (exists("meta") && !is.null(meta) && !is.null(meta$Version)) {
  meta$Version
} else {
  NA_character_
}
version_note <- if (is.na(pkg_version)) {
  "R package, development version"
} else {
  paste("R package version", pkg_version)
}

pkg_authors <- c(
  person("Shunichiro", "Orihara"),
  person("Tomotaka", "Momozaki"),
  person("Shonosuke", "Sugasawa")
)

bibentry(
  bibtype = "Article",
  key     = "orihara2025bayesian",
  title   = "Bayesian Doubly Robust Causal Inference via Posterior Coupling",
  author  = pkg_authors,
  journal = "arXiv preprint arXiv:2506.04868",
  year    = "2025",
  doi     = "10.48550/arXiv.2506.04868",
  url     = "https://arxiv.org/abs/2506.04868",
  textVersion = paste(
    "Orihara, S., Momozaki, T., & Sugasawa, S. (2025).",
    "Bayesian Doubly Robust Causal Inference via Posterior Coupling.",
    "arXiv preprint arXiv:2506.04868.",
    "doi:10.48550/arXiv.2506.04868"
  )
)

bibentry(
  bibtype = "Manual",
  key     = "drbayes-package",
  title   = "DRBayes: Bayesian Doubly Robust Causal Inference Methods",
  author  = pkg_authors,
  year    = "2025",
  note    = version_note,
  url     = "https://github.com/t-momozaki/DRBayes",
  textVersion = paste0(
    "Orihara, S., Momozaki, T., & Sugasawa, S. (2025). ",
    "DRBayes: Bayesian Doubly Robust Causal Inference Methods. ",
    version_note, ". ",
    "https://github.com/t-momozaki/DRBayes"
  )
)
